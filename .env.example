# Copy to .env and fill in before `docker compose up -d`.

# Signs login tokens. Optional: when empty, a key is generated and kept in OpenBao.
JWT_SECRET=

# Password of the bundled PostgreSQL database. Generate with: openssl rand -hex 24
# (it becomes part of a connection URL, so stick to letters and digits).
POSTGRES_PASSWORD=

# Only without OpenBao: encrypts the secrets kept in the database; falls back to JWT_SECRET when empty.
# Changing it later makes already-stored secrets unreadable.
INTEGRATION_KEY=

# OpenBao (bundled): interface and port its UI and API are published on, image, and automatic unsealing.
OPENBAO_BIND=127.0.0.1
OPENBAO_PORT=8200
# OPENBAO_IMAGE=openbao/openbao:2.7.1
OPENBAO_AUTO_UNSEAL=true

# Host port the app is published on.
INVENTORY_PORT=8080

# 1 = let webhooks call private/internal addresses.
WEBHOOK_ALLOW_PRIVATE=0
